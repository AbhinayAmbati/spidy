    "text"
   ]
  }
 },
 {
  "name": "click",
  "description": "Tap an on-screen element.",
  "parameters": {
   "type": "object",
   "properties": {
    "target": {
     "type": "object",
     "description": "How to locate the element",
     "properties": {
      "text": {
       "type": "string",
       "description": "Visible text of the element"
      },
      "contentDescription": {
       "type": "string",
       "description": "Accessibility description"
      },
      "viewId": {
       "type": "string",
       "description": "Resource id from the observation, e.g. url_bar"
      },
      "key": {
       "type": "string",
       "description": "The [key] shown for the element in the latest observation"
      },
      "className": {
       "type": "string",
       "description": "Widget class name"
      }
     }
    }
   },
   "required": [
    "target"
   ]
  }
 },
