[
 {
  "name": "open_app",
  "description": "Open an installed app by package name or app name.",
  "parameters": {
   "type": "object",
   "properties": {
    "packageName": {
     "type": "string",
     "description": "The app to open - its package name (com.google.android.youtube) or just its name (YouTube)"
    }
   },
   "required": [
    "packageName"
   ]
  }
 },
 {
  "name": "close_app",
