<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Spidey" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/spidey_background_light</item>
    </style>

    <!--
      Launcher theme. On Android 12+ the system shows this while the process warms
      up; on older versions the blue windowBackground does the same job. Either
      way the user sees blue, then the Compose splash draws the wordmark.
    -->
    <style name="Theme.Spidey.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spidey_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Spidey</item>
        <item name="android:windowBackground">@color/spidey_blue</item>
    </style>
</resources>
